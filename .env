# In a real project this file would NEVER be committed.
# For thesis demonstration purposes only, example values are provided here.
#
# Docker Compose automatically loads .env from the project root.
# To use a different file: docker compose --env-file .env.custom up

# Datasource default selection: postgres | mongo
APP_DATASOURCE=postgres

# PostgreSQL
POSTGRES_USER=postgres-admin
POSTGRES_PASSWORD=postgres-psw
POSTGRES_DB=multi_persistence_backend_postgres_db

# pgAdmin
PGADMIN_EMAIL=pg@admin.com
PGADMIN_PASSWORD=pg-psw

# MongoDB
MONGO_ROOT_USERNAME=mongo-admin
MONGO_ROOT_PASSWORD=mongo-psw

# Mongo Express basic-auth
MONGO_EXPRESS_USER=admin-basic
MONGO_EXPRESS_PASSWORD=psw-basic
